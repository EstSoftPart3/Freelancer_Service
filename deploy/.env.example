# cp .env.example .env && chmod 600 .env 후 값을 채운다. .env 는 커밋 금지.
# Git 이력에 남은 예전 값은 재사용하지 말고 새로 발급한 값을 넣는다.

SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

JWT_SECRET=
ADMIN_MASTERPASSWORD=
# 정확히 32자 (AES-256). 바꾸면 이미 올린 첨부를 열 수 없다.
FILE_ENCRYPTKEY=

SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

CLOUD_AWS_CREDENTIALS_ACCESSKEY=
CLOUD_AWS_CREDENTIALS_SECRETKEY=
CLOUD_AWS_S3_BUCKET=
