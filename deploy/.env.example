# deploy/.env 템플릿.  cp .env.example .env && chmod 600 .env  후 값을 채운다.
# 🔴 .env 는 커밋 금지(deploy/.gitignore 에서 무시 중).
# 값은 로컬 backend/src/main/resources/application.yml 에 있는 것을 그대로 옮기면 된다.

# ---------- 롤백용 이미지 태그 ----------
IMAGE_TAG=latest

# ---------- 공개 URL ----------
FO_PUBLIC_URL=https://job.estsw.co.kr
BO_PUBLIC_URL=https://admin-job.estsw.co.kr

# ---------- 포트 ----------
# 🔴 기존 컨테이너와 **같은 포트**를 쓴다. 기존을 정지시키고 갈아타므로 충돌하지 않고,
#    NPM·Cloudflare 설정을 한 줄도 바꾸지 않아도 된다.
BACKEND_PORT=8081
BACKEND_HOST_PORT=8081
FO_HOST_PORT=8082
BO_HOST_PORT=8083

# ---------- FO 내부 통신 ----------
# 🔴 두 가지를 주의할 것:
#   1) 공개 도메인을 넣지 말 것 — next.config.ts 의 /api/* rewrite 가 자기 자신을 가리켜
#      무한 루프가 된다. 반드시 컨테이너 내부 주소.
#   2) 이 값은 빌드 ARG 와 런타임 env **양쪽에** 들어간다(compose 가 알아서 한다).
#      런타임 쪽이 빠지면 SSR·sitemap 이 에러 없이 조용히 빈 값으로 폴백한다.
API_INTERNAL_BASE_URL=http://freelancer-api:8081/api

# ---------- 서버 경로 ----------
# 기존 업로드 디렉터리. 다른 경로를 주면 기존 첨부가 전부 깨진다.
UPLOAD_DIR=/DATA/freelancer_project/uploads

# ---------- DB (같은 서버의 mariadb 컨테이너) ----------
# estsoft 네트워크에 mariadb 가 있어 컨테이너명으로 통신한다.
DB_URL=jdbc:p6spy:mariadb://mariadb:3306/freelancer_project?useUnicode=true&characterEncoding=UTF-8
DB_USERNAME=
DB_PASSWORD=

# ---------- Redis (기존 컨테이너 재사용) ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- 인증 ----------
JWT_SECRET=
ADMIN_MASTER_PASSWORD=

# ---------- 메일 (Gmail SMTP) ----------
MAIL_USERNAME=
MAIL_PASSWORD=
# VOC 접수 알림 수신 주소. 비우면 발신 계정 자신에게 간다.
VOC_NOTIFY_EMAIL=

# ---------- AWS S3 ----------
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_S3_BUCKET=
AWS_REGION=ap-northeast-2

# ---------- 외부 API ----------
BUSINESS_VERIFY_API_KEY=
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# ---------- 파일 암호화 ----------
# 🔴 기존 업로드 파일을 복호화하는 키. 바꾸면 이미 올라간 첨부를 열 수 없다.
FILE_ENCRYPT_KEY=

# ---------- SEO (선택) ----------
NAVER_SITE_VERIFICATION=
GA_ID=
