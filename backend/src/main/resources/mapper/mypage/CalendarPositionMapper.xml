<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.domain.calendar.mapper.CalendarPositionMapper">
    <insert id="insert" parameterType="com.example.demo.domain.calendar.entity.CalendarPostionEvnt" useGeneratedKeys="true"
            keyProperty="postionEvntSq" keyColumn="postion_evnt_sq">
        INSERT INTO TBL_PROJECT_RECRUIT_EVNT (schedule_sq, project_sq)
        VALUES (#{scheduleSq}, #{projectSq})
    </insert>

</mapper>