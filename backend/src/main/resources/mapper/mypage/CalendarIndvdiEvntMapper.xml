<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.domain.calendar.mapper.CalendarIndvdiEvntMapper">
    <insert id="insert" parameterType="com.example.demo.domain.calendar.entity.CalendarIndvdiEvnt" useGeneratedKeys="true"
            keyProperty="indvdiEvntSq" keyColumn="indvdi_evnt_sq">
        INSERT INTO TBL_CALENDAR_INDVDI_EVNT (schedule_sq, memo)
        VALUES (#{scheduleSq}, #{memo})
    </insert>

    <update id="updateByScheduleSelective">
        UPDATE TBL_CALENDAR_INDVDI_EVNT
        <set>
            <if test="clearMemo != null and clearMemo == true">memo = NULL,</if>
            <if test="memo != null and (clearMemo == null or clearMemo == false)">
                memo = #{memo},
            </if>
        </set>
    </update>

    <select id="findDetailByScheduleSq" resultType="com.example.demo.domain.calendar.mapper.rows.PersonalDetailRow">
        SELECT cie.indvdi_evnt_sq, cie.memo FROM TBL_CALENDAR_INDVDI_EVNT cie WHERE cie.schedule_sq = #{scheduleSq} LIMIT 1
    </select>
</mapper>