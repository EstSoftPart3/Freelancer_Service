# 로컬 개발은 전부 비워도 동작한다(기본값 폴백). 운영값은 deploy/.env 로 주입한다.

# 서버(SSR·sitemap·rewrites)가 백엔드로 나가는 주소.
# 🔴 공개 도메인(https://job.estsw.co.kr/api)을 넣지 말 것 —
#    next.config.ts 의 /api/* rewrite 가 자기 자신을 가리켜 무한 루프가 된다.
#    운영값은 컨테이너 내부 주소: http://backend:8080/api
API_INTERNAL_BASE_URL=

# 구버전 폴백. API_INTERNAL_BASE_URL 이 있으면 쓰이지 않는다.
NEXT_PUBLIC_API_BASE_URL=

# canonical·sitemap·OG URL 의 기준 도메인. 미설정 시 https://freelancer-service.com 으로 폴백해
# 검색엔진에 엉뚱한 도메인이 올라간다. 운영: https://job.estsw.co.kr
NEXT_PUBLIC_SITE_URL=

# 네이버 서치어드바이저 소유확인 content 값 (searchadvisor.naver.com > HTML 태그 방식)
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=

# Google Analytics 측정 ID (G-XXXXXXX). 비우면 GA 스크립트를 넣지 않는다.
NEXT_PUBLIC_GA_ID=
